---
/** Iconos SVG en línea. Marcas desde simple-icons (solo en build, sin JS en el cliente). */
import { siWhatsapp, siInstagram, siTiktok } from 'simple-icons';

interface Props {
  name: 'whatsapp' | 'instagram' | 'tiktok' | 'leaf' | 'arrow' | 'menu' | 'back';
  class?: string;
}
const { name, class: className } = Astro.props;

const brand: Record<string, string> = {
  whatsapp: siWhatsapp.path,
  instagram: siInstagram.path,
  tiktok: siTiktok.path,
};
---

{brand[name] ? (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={brand[name]} /></svg>
) : name === 'leaf' ? (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
    <path d="M20.5 3.5c-8.6.2-14.6 3.7-15.9 10.1-.4 1.9-.1 3.7.6 5.1L3 20.9l1.1 1.1 2.2-2.2c1.4.8 3.1 1 5 .6 6.5-1.3 9.9-7.3 10.1-15.9V3.5h-.9Zm-9.6 14.9c-1.3.3-2.5.2-3.5-.3l6.9-6.9-1.1-1.1-6.9 6.9c-.5-1-.6-2.2-.3-3.5C7 8.4 11.7 5.3 18.9 5.1c-.2 7.2-3.3 11.9-8 13.3Z" />
  </svg>
) : name === 'arrow' ? (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
) : name === 'back' ? (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
) : (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
)}
