---
/** Ramita botánica en trazo fino, como las ilustraciones de línea del catálogo. Solo trazos. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['sprig', className]} viewBox="0 0 200 260" aria-hidden="true" focusable="false">
  <path d="M60 255C70 200 92 150 128 105c22-27 44-50 62-95" />
  <path d="M74 205c-22-6-40-22-48-46 24 2 42 18 48 46Z" />
  <path d="M83 183c18-14 40-18 62-10-16 18-38 22-62 10Z" />
  <path d="M96 156c-20-10-32-30-34-54 22 8 34 28 34 54Z" />
  <path d="M110 133c16-18 36-26 60-22-12 20-34 28-60 22Z" />
  <path d="M124 110c-16-14-24-36-20-60 18 14 26 36 20 60Z" />
  <path d="M142 86c14-18 32-28 54-28-8 20-28 30-54 28Z" />
  <path d="M160 58c-10-16-12-36-4-56 14 16 16 36 4 56Z" />
</svg>

<style>
  .sprig {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
</style>
