---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen Open Graph (relativa al sitio). */
  ogImage?: string;
  /** Oculta el botón flotante (las páginas de producto tienen su propia barra de compra). */
  hideFab?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og.jpg',
  hideFab = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} · Materos de concreto | Catálogo`;
const base = Astro.site;
const canonical = base ? new URL(Astro.url.pathname, base).href : undefined;
const ogImageUrl = base ? new URL(ogImage, base).href : ogImage;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  sameAs: [site.instagram.url, site.tiktok.url],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${site.whatsapp.number}`,
    contactType: 'sales',
    availableLanguage: 'es',
  },
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#547236" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-text" preload />
    <script type="application/ld+json" set:html={JSON.stringify([organization, ...jsonLd])} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {!hideFab && <WhatsAppFab />}
  </body>
</html>
